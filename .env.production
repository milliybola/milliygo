# ─── MilliyGo (mijoz sayti) ─────────────────────────────────────────────
# Backend API (REST). Mahalliy backend ishlatish uchun: http://localhost:8081
NEXT_PUBLIC_API_BASE_URL = https://mytizim.uz

# Jonli kuzatish (WebSocket). Bo'sh qoldirilsa API manzilidan olinadi (https -> wss)
NEXT_PUBLIC_WS_BASE_URL = wss://mytizim.uz

# Sayt manzili (canonical, Open Graph, sitemap uchun)
NEXT_PUBLIC_SITE_URL = https://www.milliyapp.uz

# ApiGap belgilari foydalanuvchilarga ko'rinmasin
NEXT_PUBLIC_SHOW_API_GAPS = false

# ─── Eski modullar (chat, xarita rasmlari) ──────────────────────────────
NEXT_PUBLIC_BASE_URL = https://mytizim.uz
NEXT_PUBLIC_CHAT_BASE_URL = https://mytizim.uz
NEXT_PUBLIC_WEBSOCKET_URL = wss://mytizim.uz/ws
NEXT_PUBLIC_TELEGRAM_AUTH_BOT=MilliyGoApp_bot
