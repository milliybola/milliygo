# ─── MilliyGo (mijoz sayti) ─────────────────────────────────────────────
# Backend API (REST): mahalliy backend. Haqiqiy server uchun: https://mytizim.uz
NEXT_PUBLIC_API_BASE_URL = http://localhost:8081

# Jonli kuzatish (WebSocket). Bo'sh qoldirilsa API manzilidan olinadi (https -> wss)
NEXT_PUBLIC_WS_BASE_URL = ws://localhost:8081

# Sayt manzili (canonical, Open Graph, sitemap uchun)
NEXT_PUBLIC_SITE_URL = http://localhost:7080

# ApiGap (API yetishmayotgan joy) belgilarini ko'rsatish
NEXT_PUBLIC_SHOW_API_GAPS = true

# ─── Eski modullar (chat, xarita rasmlari) ──────────────────────────────
NEXT_PUBLIC_BASE_URL = http://localhost:8081
NEXT_PUBLIC_CHAT_BASE_URL = http://localhost:8081
NEXT_PUBLIC_WEBSOCKET_URL = wss://mytizim.uz/ws
NEXT_PUBLIC_TELEGRAM_AUTH_BOT=milliygo_auth_dev_bot
